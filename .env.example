# Copy to .env and adjust. No credentials are required for the core demo.
GAMEOPS_DATASET=demo                 # demo | steam (after running src/ingestion/steam.py)
GAMEOPS_EMBEDDER=auto                # auto | sentence-transformers | spacy | tfidf
GAMEOPS_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
GAMEOPS_ALLOW_MODEL_DOWNLOAD=0       # 1 lets auto mode download Sentence-Transformers weights
OLLAMA_URL=                          # e.g. http://localhost:11434 to enable the LLM tool-calling path
OLLAMA_MODEL=llama3.2:3b
AGENT_MAX_TOOL_CALLS=5
TOOL_TIMEOUT_S=10
